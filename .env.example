# ─────────────────────────────────────────────────────────────────────────────
# Kay Lim Construction Dashboard — Environment Variables
# Copy this file to .env and fill in the values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ── Autodesk Platform Services (APS / ACC) ───────────────────────────────────
# 1. Go to https://aps.autodesk.com > Create App
# 2. Enable APIs: Data Management, Issues, Quality Checklists
# 3. Copy Client ID and Client Secret below
# 4. In ACC Admin > Apps, authorise the app for your account
APS_CLIENT_ID=your_aps_client_id_here
APS_CLIENT_SECRET=your_aps_client_secret_here

# These are Kay Lim's actual ACC IDs (already set — do not change)
ACC_ACCOUNT_ID=your_acc_account_id
ACC_PROJECT_ID=your_acc_project_id

# ── Power BI Embedded ─────────────────────────────────────────────────────────
# Setup (IT admin, one-time):
#   1. Azure Portal > App Registrations > New registration
#      → Note Application (client) ID and Tenant ID
#   2. Certificates & Secrets > New client secret → note the value
#   3. Azure > Groups > Create security group → add the service principal
#   4. Power BI Admin Portal > Tenant Settings > Developer Settings
#      → Enable "Allow service principals to use Power BI APIs" for the group
#      → Enable "Embed content in apps"
#   5. Power BI workspace > Settings > Access → add the service principal as Member
# Reference: https://learn.microsoft.com/en-us/power-bi/developer/embedded/embed-service-principal
PBI_TENANT_ID=your_azure_tenant_id
PBI_CLIENT_ID=your_azure_app_client_id
PBI_CLIENT_SECRET=your_azure_app_client_secret
PBI_WORKSPACE_ID=your_power_bi_workspace_id
PBI_REPORT_ID=your_power_bi_report_id

# ── Insight QSE (CAPPS Solutions) ────────────────────────────────────────────
# CAPPS does not publish a public API. Contact them to request API access:
#   Email : contact@capps.com.sg
#   Phone : +65 6509 0309
#   Office: 8 Burn Road #06-09/10, Trivex, Singapore 369977
# Mention that Kay Lim Construction is an existing customer of kaylim.insightqse.com
QSE_BASE_URL=https://kaylim.insightqse.com
QSE_API_KEY=ask_capps_for_api_key

# ── UniCon ────────────────────────────────────────────────────────────────────
# UniCon has no documented public API. Contact UniCon support to request API/webhook access:
#   Web : https://app.unicongroup.co
#   Email: support@unicongroup.co (or use in-app support)
# Provide Kay Lim's Company ID so they can enable API access for your account.
UNICON_BASE_URL=https://app.unicongroup.co
UNICON_API_KEY=ask_unicon_for_api_key
UNICON_COMPANY_ID=your_unicon_company_id
