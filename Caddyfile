# Auto-TLS (Let's Encrypt) once DNS A/AAAA records for these names point at the
# host. Caddy redirects HTTP->HTTPS automatically and proxies WebSockets (used
# by the IDD Socket.io realtime feed) without extra config.

(secure) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# IDD Production subdomain: rewrite bare root to /idd, pass all other paths through.
idd.{$DOMAIN} {
	import secure
	handle / {
		rewrite * /idd
		reverse_proxy app:3001
	}
	handle {
		reverse_proxy app:3001
	}
}

# Command Centre (main domain + cc. alias) — proxy everything to the unified server.
{$DOMAIN}, cc.{$DOMAIN} {
	import secure
	reverse_proxy app:3001
}
