# ─────────────────────────────────────────────────────────────────────────────
# Deployment configuration — copy to .env (NEVER commit .env).
#   docker compose --env-file .env up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# Your domain (supervisor's DNS). Create A/AAAA records for all three at the host IP:
#   ${DOMAIN}        cc.${DOMAIN}        idd.${DOMAIN}
DOMAIN=kaylim.example.com

# Shared token-signing secret for BOTH services. Generate once:
#   openssl rand -hex 32
# If this differs between the two services, tokens won't validate across them.
SESSION_SECRET=replace_with_a_long_random_hex_string

# First-run head_of_it (IT admin) password. Used to bootstrap the user store.
ADMIN_PASSWORD=choose_a_strong_admin_password

# Strict integration mode: 1 = a configured-but-failing vendor returns 502
# (never silent mock). Recommended ON in production.
INTEGRATIONS_STRICT=1

# ── Vendor credentials (optional; blank = mock / not-configured) ──────────────
APS_CLIENT_ID=
APS_CLIENT_SECRET=
ACC_ACCOUNT_ID=
ACC_PROJECT_ID=
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_WORKSPACE_ID=
PBI_REPORT_ID=
# Comma-separated report UUIDs this deployment is allowed to embed. Required
# in production once PBI_* is set — see POWERBI_ALLOWED_REPORTS in .env.example.
POWERBI_ALLOWED_REPORTS=
QSE_BASE_URL=
QSE_API_KEY=
UNICON_BASE_URL=
UNICON_API_KEY=
UNICON_COMPANY_ID=
